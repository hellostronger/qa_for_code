# ============================================================
# Code QA Service — 环境变量模板
# 复制为 .env 并修改
# ============================================================

# -------- 必填 --------

# Anthropic API Key（二选一，推荐）
# 获取: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# 源码目录路径（容器内路径，与 docker-compose.yml 的挂载对应）
SOURCE_REPO_PATH=/src-repo

# 生成文件工作区（容器内路径，与 docker-compose.yml 的挂载对应）
WORKSPACE_DIR=/workspace

# -------- 可选 --------

# 服务端口
PORT=3100

# Claude Code 模型 (空 = 默认)
# CLAUDE_MODEL=claude-sonnet-4-5

# 会话过期时间 ms（默认 30 分钟）
SESSION_TTL_MS=1800000

# 单次问答超时 ms（默认 5 分钟）
RUN_TIMEOUT_MS=300000

# 最大并发 Claude Code 进程数
MAX_CONCURRENT=3

# -------- 第三方 API 代理（可选）--------
# 使用第三方兼容 Anthropic API 的服务:
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-your-api-key
# ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-chat
