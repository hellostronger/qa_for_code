# Server
PORT=3100

# Source code directory for Claude Code to analyze
SOURCE_REPO_PATH=./src-repo

# Claude Code model (leave empty for default)
CLAUDE_MODEL=

# Custom Claude binary path (leave empty for PATH lookup)
CLAUDE_BIN=

# Session TTL in ms (default: 30 minutes)
SESSION_TTL_MS=1800000

# Max seconds per run (default: 5 minutes)
RUN_TIMEOUT_MS=300000

# Max concurrent Claude Code processes
MAX_CONCURRENT=3

# Extra CORS origin (optional, localhost is always allowed)
CORS_ORIGIN=
